rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'soham.pr19@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. User Profiles
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(userId);
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // 2. Canteen Orders
    match /canteenOrders/{orderId} {
      allow get: if isSignedIn() && isValidId(orderId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(orderId);
      allow update: if isSignedIn() && isValidId(orderId);
      allow delete: if isAdmin();
    }

    // 3. Maintenance Grievances & Complaints
    match /complaints/{complaintId} {
      allow get: if isSignedIn() && isValidId(complaintId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(complaintId);
      allow update: if isSignedIn() && isValidId(complaintId);
      allow delete: if isAdmin();
    }

    // 4. University Circulars & Notices
    match /notices/{noticeId} {
      allow get: if isSignedIn() && isValidId(noticeId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(noticeId);
      allow update: if isSignedIn() && isValidId(noticeId);
      allow delete: if isAdmin();
    }

    // 5. Document & Certificate Requests
    match /documentRequests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(requestId);
      allow update: if isSignedIn() && isValidId(requestId);
      allow delete: if isAdmin();
    }

    // 6. Coursework & Academic Tasks (Faculty create, students submit)
    match /tasks/{taskId} {
      allow get: if isSignedIn() && isValidId(taskId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(taskId);
      allow update: if isSignedIn() && isValidId(taskId);
      allow delete: if isAdmin();
    }

    // 7. Test connection probe doc
    match /test/{docId} {
      allow read, write: if isSignedIn();
    }
  }
}
